# PM-MCP environment. Copy to .env; every key is optional; features that need a missing key are skipped.

# ---- LLM (Anthropic Claude): news summaries, news_sentiment(use_llm=True), report_create(kind="theme")
# Key: https://platform.claude.com (or run `ant auth login` instead of setting a key)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
# low|medium|high|xhigh|max
# LLM_EFFORT=
# LLM_MAX_OUTPUT_TOKENS=
# LLM_TIMEOUT_SEC=
# LLM_MAX_RETRIES=

# ---- US market data
# finnhub_data
FINNHUB_API_KEY=
# stock_snapshot technical signals (US)
ALPHA_VANTAGE_API_KEY=
# seconds between calls (free tier: 15, paid: 1)
ALPHA_VANTAGE_CALL_DELAY=15
# "Your Name your@email.com" - SEC blocks anonymous clients
SEC_EDGAR_USER_AGENT=

# ---- Korean market data (PyKrx needs no key)
# OpenDART financials
DART_API_KEY=
# KIS Developers price fallback
KIS_APP_KEY=
KIS_APP_SECRET=

# ---- HTTP transport (scripts/run_mcp_http.sh)
# HOST=127.0.0.1
# PORT=8010
# required when HOST is not loopback
PM_MCP_TOKEN=
# comma-separated Host headers for non-loopback HOST
ALLOWED_HOSTS=

# ---- Scoring (optional)
# SCORE_WEIGHTS=growth=0.25,profitability=0.25,valuation=0.25,quality=0.25
# SCORE_SECTOR_NEUTRAL=false
# JSON: per-sector factor weights
# SECTOR_FACTOR_WEIGHTS=
# default: mcp_server/data/event_weights.json
# EVENT_WEIGHTS_PATH=

# ---- Scheduler & paths (optional)
# SCHEDULER_TIMEZONE=Asia/Seoul
# default: data/watchlist.json
# WATCHLIST_PATH=
# IMAGE_OUTPUT_DIR=/tmp/pm-mcp-images

# ---- Report presentation (optional)
# PRESENT_PRESET=modern
# PRESENT_THEME_CHART_DAYS=180
# PRESENT_PORTFOLIO_HISTORY_DAYS=60
# PRESENT_YSCALE=linear        # linear|log
# PRESENT_MA_WINDOWS=20,50
# PRESENT_COLORS=#2563eb,#16a34a,#f59e0b,#ef4444,#8b5cf6
# PRESENT_NEWS_MAX=7
# PRESENT_FILINGS_MAX=7
# PRESENT_MPL_STYLE=seaborn-v0_8
