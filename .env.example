# Anthropic Claude - Required for LLM summaries / LLM news sentiment
# Key: https://platform.claude.com (or run `ant auth login` instead of setting a key)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
# Optional: LLM_EFFORT=low|medium|high|xhigh|max, LLM_MAX_OUTPUT_TOKENS, LLM_TIMEOUT_SEC, LLM_MAX_RETRIES

# Finnhub (optional)
FINNHUB_API_KEY=

# Alpha Vantage (optional)
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_CALL_DELAY=15

# SEC EDGAR
SEC_EDGAR_USER_AGENT=

DART_API_KEY=
KIS_APP_KEY=
KIS_APP_SECRET=
FX_API_URL=
# HTTP transport (scripts/run_mcp_http.sh)
PM_MCP_TOKEN=
ALLOWED_HOSTS=
